# Qovluqların siyahıya alınmasını söndür
Options -Indexes

# Təhlükəsizlik başlıqları
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://kontaktshome.com"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Həssas faylların birbaşa yüklənməsini qadağan et
<FilesMatch "\.(env|log|ini|sql|bak|config|git|sh)$">
    Require all denied
</FilesMatch>

# Botların və terminal alətlərinin girişini blokla
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (curl|wget|python|bot|spider|nikto|sqlmap) [NC]
    RewriteRule ^ - [F,L]
</IfModule>
